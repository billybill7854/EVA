# Telegram Bot Configuration (fallback/webhook mode)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_WEBHOOK_URL=https://your-space-name.hf.space/webhook/telegram

# Eva's real Telegram USER account (MTProto via Pyrogram)
# This gives Eva more capabilities: initiating chats, reactions, etc.
# Step 1: Go to https://my.telegram.org → "API development tools" → create app
# Step 2: Get api_id (integer) and api_hash (string) from there
# Step 3: Set EVA_PHONE to Eva's actual phone number (+country code)
# Step 4: Set TELEGRAM_USER_MODE=true
# Step 5: On first run, Eva will prompt for the OTP sent to her phone
TELEGRAM_USER_MODE=false
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=your_telegram_api_hash_here
EVA_PHONE=+10000000000
TELEGRAM_SESSION_NAME=eva_session
TELEGRAM_SESSION_DIR=.

# NVIDIA API Keys (from your implementation_guide.txt)
NVIDIA_API_KEY_MAIN=your_nvidia_api_key_main
NVIDIA_API_KEY_TTS=your_nvidia_api_key_tts
NVIDIA_API_KEY_STT=your_nvidia_api_key_stt

# NVIDIA Model IDs
NVIDIA_ORCHESTRATOR_MODEL=nvidia/nemotron-3-super-120b-a12b
NVIDIA_AGENT_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_CHAT_MODEL_1=google/diffusiongemma-26b-a4b-it
NVIDIA_CHAT_MODEL_2=moonshotai/kimi-k2.6
NVIDIA_TTS_MODEL=magpie-tts-multilingual
NVIDIA_STT_MODEL=whisper-large-v3
NVIDIA_IMAGE_GEN_MODEL=black-forest-labs/FLUX.1-dev

# Database (SQLite for HuggingFace Spaces, PostgreSQL for production)
DATABASE_URL=sqlite:///data/eva.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@host:5432/eva_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=eva_db
DATABASE_USER=eva_user
DATABASE_PASSWORD=secure_password

# Redis Cache (optional - comment out if not using)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# Pinecone Vector DB (for semantic memory - optional)
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_ENVIRONMENT=gcp-starter
PINECONE_INDEX_NAME=eva-memory

# Google APIs (Gmail, Calendar, Drive - optional, requires OAuth setup)
GOOGLE_CLIENT_ID=your_client_id
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=https://your-space-name.hf.space/auth/google/callback

# Gmail Configuration (optional)
GMAIL_SERVICE_ACCOUNT_EMAIL=your_service_account@project.iam.gserviceaccount.com

# Stripe API (for payments - optional)
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Web Search API (Serper - optional)
SERPER_API_KEY=your_serper_api_key

# Wise/TransferWise (for payments - optional)
WISE_API_TOKEN=your_wise_api_token
WISE_PROFILE_ID=your_wise_profile_id

# Primary User Configuration
# telegram_id: get yours by messaging @userinfobot on Telegram
# IMPORTANT: Use YOUR real identifiers here. Do not commit real values.
PRIMARY_USER_PHONE=+10000000000
PRIMARY_USER_TELEGRAM_ID=123456789
PRIMARY_USER_USERNAME=your_username
PRIMARY_USER_NAME=YourName

# Admin API Key for secure admin endpoints
ADMIN_API_KEY=your_secure_admin_api_key_here
# Trusted contacts — comma-separated Telegram IDs e.g. "111111111,222222222"
TRUSTED_CONTACT_IDS=

# Application Settings
DEBUG=False
APP_NAME=EVA
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Admin API for /admin/* endpoints (optional but recommended if exposing the API)
# Send it as header: X-Admin-Token: <value>
ADMIN_API_KEY=change_me_to_a_long_random_string

# Tool robustness
TOOL_TIMEOUT_SECONDS=20
TOOL_MAX_CALLS_PER_REQUEST=3
ORCHESTRATOR_JSON_REPAIR_ATTEMPTS=1

# Server Configuration (HuggingFace Spaces uses port 7860)
HOST=0.0.0.0
PORT=7860
WORKERS=1

# CORS Configuration
ALLOWED_ORIGINS=https://your-space-name.hf.space,http://localhost:3000
